# =============================================
# .env 파일 예시 - 이 파일은 Git에 올려도 됩니다.
# 실제 값은 .env 파일에 넣고 .gitignore에 추가하세요.
# =============================================

# JWT
JWT_SECRET=your-base64-encoded-secret-key-here

# Database
DB_URL=jdbc:mysql://localhost:3308/minlog_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
